{
  "name": "demo-machine",
  "version": "0.3.0",
  "description": "Demo as code — automate polished product demo videos from YAML specs",
  "type": "module",
  "bin": {
    "demo-machine": "./dist/cli.js",
    "demo-machine-mcp": "./dist/mcp-server.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "docs/",
    "examples/",
    "remotion/",
    "GETTING-STARTED.md",
    "ROADMAP.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --max-warnings=0 --cache",
    "format": "prettier --check --cache .",
    "format:fix": "prettier --write --cache .",
    "typecheck": "tsc --noEmit",
    "spell": "cspell --no-progress \"*.md\" \"src/**/*.ts\" \"tests/**/*.ts\" \"docs/**/*.md\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "dep-check": "dependency-cruiser src --config",
    "mutation": "stryker run",
    "quality:verify": "node scripts/quality-verify.mjs",
    "quality:verify:strict": "node scripts/quality-verify.mjs --strict-coverage",
    "local-ready": "node scripts/local-ready.mjs",
    "release-ready": "node scripts/release-ready.mjs",
    "release-ready:fast": "node scripts/release-ready.mjs --skip-smoke --skip-video",
    "release:gates": "node scripts/release-gates.mjs",
    "release:gates:tools": "node scripts/release-gates.mjs --checks tools",
    "release:gates:gallery": "node scripts/release-gates.mjs --checks gallery",
    "release:gates:showcase": "node scripts/release-gates.mjs --checks showcase",
    "qa:meta-prompt": "node scripts/meta-prompt-qa.mjs",
    "qa:meta-prompt:run": "node scripts/meta-prompt-qa.mjs --run-codex",
    "examples:validate": "node scripts/examples-suite.mjs --mode validate",
    "examples:validate:pr": "node scripts/examples-suite.mjs --mode validate --release-tier pr --suite-type showcase --canonical-only",
    "examples:capture": "node scripts/examples-suite.mjs --mode capture",
    "examples:capture:pr": "node scripts/examples-suite.mjs --mode capture --release-tier pr --suite-type showcase --canonical-only",
    "examples:smoke:pr": "node scripts/examples-suite.mjs --mode run --release-tier pr --suite-type showcase --canonical-only",
    "demo:gallery": "node scripts/demo-gallery.mjs",
    "demo:health": "node scripts/demo-health-dashboard.mjs",
    "golden-frames": "node scripts/golden-frames.mjs",
    "golden-frames:compare": "node scripts/golden-frames.mjs --compare",
    "golden-frames:update": "node scripts/golden-frames.mjs --update",
    "visual-diff": "node scripts/visual-diff-gate.mjs",
    "visual-diff:update": "node scripts/visual-diff-gate.mjs --update-baselines",
    "video:assure": "node scripts/video-assurance.mjs",
    "prepublishOnly": "pnpm local-ready",
    "prepare": "husky",
    "validate": "pnpm lint && pnpm format && pnpm spell && pnpm typecheck && pnpm test && pnpm knip && pnpm dep-check && pnpm quality:verify:strict"
  },
  "dependencies": {
    "@45ck/video-evaluator": "github:45ck/video-evaluator",
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^13.1.0",
    "json5": "^2.2.3",
    "kokoro-js": "^1.2.1",
    "openai": "^6.22.0",
    "playwright": "^1.58.2",
    "tree-kill": "^1.2.2",
    "yaml": "^2.8.3",
    "zod": "^3.24.2"
  },
  "peerDependencies": {
    "@remotion/bundler": ">=4.0.0",
    "@remotion/media-utils": ">=4.0.0",
    "@remotion/renderer": ">=4.0.0",
    "pixelmatch": ">=5.0.0",
    "pngjs": ">=6.0.0",
    "react": ">=18.0.0",
    "remotion": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@remotion/bundler": {
      "optional": true
    },
    "@remotion/media-utils": {
      "optional": true
    },
    "@remotion/renderer": {
      "optional": true
    },
    "pixelmatch": {
      "optional": true
    },
    "pngjs": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "remotion": {
      "optional": true
    }
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "@vitest/coverage-v8": "^3.0.5",
    "cspell": "^8.17.3",
    "dependency-cruiser": "^16.9.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-sonarjs": "^0.25.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "knip": "^6.7.0",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --check",
      "eslint --max-warnings=0 --cache"
    ],
    "tests/**/*.{ts,tsx}": [
      "prettier --check"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --check"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/45ck/demo-machine.git"
  },
  "homepage": "https://github.com/45ck/demo-machine",
  "bugs": {
    "url": "https://github.com/45ck/demo-machine/issues"
  },
  "license": "MIT",
  "author": "45ck",
  "keywords": [
    "demo",
    "video",
    "automation",
    "playwright",
    "ffmpeg",
    "product-demo",
    "screen-recording",
    "yaml",
    "json5",
    "toml",
    "remotion",
    "cli",
    "demo-as-code"
  ],
  "pnpm": {
    "overrides": {
      "@hono/node-server": "1.19.13",
      "flatted": "3.4.2",
      "hono": "4.12.14",
      "minimatch": "9.0.7",
      "brace-expansion": "5.0.5",
      "picomatch": "4.0.4",
      "postcss": "8.5.10",
      "protobufjs": "7.5.5",
      "rollup": "4.59.0",
      "tar": "7.5.11",
      "underscore": "1.13.8",
      "vite": "7.3.2"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "husky"
    ]
  }
}
